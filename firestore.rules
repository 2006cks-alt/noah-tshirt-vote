rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // team designs — anyone can add / edit / delete (matches the trust level
    // this app already ran with on Claude's artifact platform)
    match /designs/{designId} {
      allow read: if true;
      allow write: if true;
    }

    // aggregate vote counts, keyed by design id
    match /votes/{voteDoc} {
      allow read: if true;
      allow write: if true;
    }

    // attendance record (student id + name + timestamp only — never which
    // design they picked)
    match /voters/{sid} {
      allow read: if true;
      allow write: if true;
    }

    // each viewer's OWN vote choice — only that signed-in-anonymously
    // viewer can read or write their own doc. Nobody else (not the app,
    // not an admin) can read another viewer's row. This is what makes the
    // "only you can see what you picked" promise actually true.
    match /myVotes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
