rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // team designs — anyone can add / edit / delete (matches the trust level
    // this app already ran with on Claude's artifact platform)
    match /designs/{designId} {
      allow read: if true;
      allow write: if true;
    }

    // aggregate vote counts, keyed by design id
    match /votes/{voteDoc} {
      allow read: if true;
      allow write: if true;
    }

    // attendance record (student id + name + password hash + timestamp —
    // never which design they picked). Anyone can register a fresh student
    // id, but an EXISTING one can only be overwritten by a write that
    // already carries the same passwordHash it currently has — so nobody
    // can take over someone else's row (or reset their password) without
    // already knowing their password, even by talking to Firestore directly.
    match /voters/{sid} {
      allow read: if true;
      allow create: if request.resource.data.passwordHash is string;
      allow update: if request.resource.data.passwordHash == resource.data.passwordHash;
      allow delete: if false;
    }

    // each viewer's OWN vote choice — only that signed-in-anonymously
    // viewer can read or write their own doc. Nobody else (not the app,
    // not an admin) can read another viewer's row. This is what makes the
    // "only you can see what you picked" promise actually true.
    match /myVotes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
